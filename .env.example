# ============================================
# 视频去水印解析服务配置
# ============================================

# 可选：Basic Auth 认证（设置后访问需要账号密码）
# PARSE_VIDEO_USERNAME=admin
# PARSE_VIDEO_PASSWORD=your_password

# 可选：HTTP/HTTPS 代理（用于访问被墙或受限平台）
# PARSE_VIDEO_PROXY=http://127.0.0.1:7890
# PARSE_VIDEO_PROXY=http://user:pass@proxy.example.com:8080

# 可选：请求超时（秒），默认 30
# PARSE_VIDEO_TIMEOUT=30

# 可选：每 IP 每分钟请求上限，默认 120；设为 0 关闭限流
# PARSE_VIDEO_RATE_LIMIT=120

# 可选：批量解析并发数（默认 5，0 会被当作 1）
# PARSE_VIDEO_BATCH_CONCURRENCY=5

# 可选：下载代理白名单追加域名后缀（逗号分隔，不带前导点）。
# 例如某平台媒体 CDN 域名是 media.example.com，填 example.com 即可放行其子域。
# PARSE_VIDEO_DOWNLOAD_ALLOW_HOSTS=example.com,another-cdn.net

# 可选：设为 1 跳过下载域名白名单（内网/保留地址拦截仍生效），
# 仅自托管排查新平台时临时使用，公网部署不建议开启
# PARSE_VIDEO_DOWNLOAD_ALLOW_ALL=0

# 可选：服务端口（使用 python main.py 启动时生效），默认 8000
# PARSE_VIDEO_PORT=8000
